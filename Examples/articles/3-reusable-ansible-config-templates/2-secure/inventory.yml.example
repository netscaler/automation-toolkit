---
# Copy to inventory.yml and adjust. inventory.yml is gitignored.
# No NetScaler credentials here: they are read from GCP Secret Manager at run time.
netscaler:
  hosts:
    netscaler-vpx:
      nsip: "<NSIP>"
  vars:
    ansible_connection: local
    ansible_python_interpreter: "{{ ansible_playbook_python }}"

    gcp_project: "adc-pm-demo"
    # Same key as the Terraform use cases; needs roles/secretmanager.secretAccessor
    gcp_service_account_file: "{{ lookup('ansible.builtin.env', 'HOME') }}/terraform-sa.json"

    netscaler_private_vip: "192.168.42.2"
    apps_private_ip_addresses:
      - "10.156.0.10"
      - "10.156.0.11"
