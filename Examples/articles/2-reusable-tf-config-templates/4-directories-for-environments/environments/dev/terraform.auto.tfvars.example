# Copy to terraform.auto.tfvars and adjust. *.tfvars is gitignored.
gcp_project = "<YOUR_GCP_PROJECT>"
region = "<YOUR_PREFERED_REGION>"
nsip = "<DEV_NSIP>"
# No VIP: the common content switching vserver owns it
# netscaler_private_vip = "192.168.42.2"
apps_private_ip_addresses = [
  "10.156.0.11",
  "10.156.0.10"
]
lbvserver_name = "kk-tf-dev-lb"
servicegroup_name = "kk-tf-dev-servicegroup"
ns_username_secret = "dev-ns-username"
ns_password_secret = "dev-ns-password"